CORENAME ?= hatarib
platform ?= invalid
COREFILE ?= $(CORENAME)_libretro
CORESTATIC ?= $(CORENAME)_libretro_$(platform)
CORESTATIC_SUFFIX ?= .a
MAKEACTION ?= core
MAKEEXTRA ?=

ifeq ($(platform),win64)                        # windows-x64-mingw
	MAKEEXTRA := "CMAKE_FLAGS=-DCMAKE_SYSTEM_NAME=Windows" SO_SUFFIX=.dll
else ifeq ($(platform),win32)                   # windows-i686-mingw
	MAKEEXTRA := "CMAKE_FLAGS=-DCMAKE_SYSTEM_NAME=Windows" SO_SUFFIX=.dll
else ifeq ($(platform),unix)
ifneq ($(ARCH),x86)                             # linux-x64, linux-aarch64
else                                            # linux-i686
endif
else ifeq ($(platform),osx)
ifneq ($(ARCH),arm)                             # osx-x64
else                                            # osx-arm64
endif
else ifeq ($(ANDROID_PLATFORM),android_arm)     # android-make: android-arm
else ifeq ($(ANDROID_PLATFORM),android_arm64)   # android-make: android-arm64
else ifeq ($(ANDROID_PLATFORM),android_x86)     # android-make: android-x86
else ifeq ($(ANDROID_PLATFORM),android_x86_64)  # android-make: android-x86_64
else ifeq ($(platform),ios-arm64)               # ios-arm64
else ifeq ($(platform),ios9)                    # ios9
else ifeq ($(platform),ps2)                     # ps2-static
	MAKEACTION := static
else ifeq ($(platform),psl1ght)                 # psl1ght-static
	MAKEACTION := static
else ifeq ($(platform),psp1)                    # psp-static
	MAKEACTION := static
else ifeq ($(platform),vita)                    # vita-static
	MAKEACTION := static
else ifeq ($(platform),ctr)                     # ctr-static
	MAKEACTION := static
else ifeq ($(platform),ngc)                     # ngc-static
	MAKEACTION := static
else ifeq ($(platform),wii)                     # wii-static
	MAKEACTION := static
else ifeq ($(platform),wiiu)                    # wiiu-static
	MAKEACTION := static
else ifeq ($(platform),libnx)                   # libnx-static
	MAKEACTION := static
else ifeq ($(platform),emscripten)              # emscripten-static
	MAKEACTION := static
	CORESTATIC_SUFFIX := .bc
endif

.PHONY: default libretro

default: libretro

libretro:
	$(MAKE) -f makefile zlib
	$(MAKE) -f makefile $(MAKEACTION) COREFILE=$(COREFILE) COREDIR=. CORESTATIC=$(CORESTATIC)$(CORESTATIC_SUFFIX) $(MAKEEXTRA)
